{
  "name": "Social Accounts Connect Dashboard - Full",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "connect-dashboard",
        "responseMode": "lastNode",
        "responseData": "={{$node[\"HTML Response\"].json[\"body\"]}}"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    body: `<html><head><title>Connect Social Accounts</title></head><body>\n    <h2>Connect Your Social Accounts</h2>\n    <ul>\n      <li><a href='https://n8n-pxx8.onrender.com/rest/credentials/oauth2/authorize?type=googleGmailOAuth2Api'>Connect Gmail</a></li>\n      <li><a href='https://n8n-pxx8.onrender.com/rest/credentials/oauth2/authorize?type=youtubeOAuth2Api'>Connect YouTube</a></li>\n      <li><a href='https://n8n-pxx8.onrender.com/rest/credentials/oauth2/authorize?type=instagramOAuth2Api'>Connect Instagram</a></li>\n      <li><a href='https://n8n-pxx8.onrender.com/rest/credentials/oauth2/authorize?type=tiktokOAuth2Api'>Connect TikTok</a></li>\n      <li><a href='https://n8n-pxx8.onrender.com/rest/credentials/oauth2/authorize?type=facebookGraphApi'>Connect Facebook</a></li>\n      <li><a href='https://n8n-pxx8.onrender.com/rest/credentials/oauth2/authorize?type=linkedInOAuth2Api'>Connect LinkedIn</a></li>\n      <li><a href='https://n8n-pxx8.onrender.com/rest/credentials/oauth1/authorize?type=twitterOAuth1Api'>Connect X/Twitter</a></li>\n    </ul>\n    <p>Click a button to authorize the account. Once authorized, it will be saved in n8n credentials and ready to use in workflows.</p>\n    </body></html>`\n  }\n}];"
      },
      "name": "HTML Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "HTML Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
